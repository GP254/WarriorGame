config_version=5

[application]
config/name="Ashen Banner"
config/icon="res://assets/art/app-icon.png"
config/version="0.4.1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.035,0.055,0.045,1)
boot_splash/show_image=false

[autoload]
Campaign="*res://scripts/campaign.gd"
Art="*res://scripts/art.gd"
Sound="*res://scripts/sound.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.045,0.065,0.05,1)

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[audio]
general/ios/mix_with_others=true

[physics]
common/physics_ticks_per_second=30
